    "# Capture successful and failed scans so the publisher can report the actual outcome.\nimport traceback as _scan_traceback\nimport re as _scan_re\nfrom datetime import datetime as _scan_datetime, timezone as _scan_timezone\nSCAN_RUN_ID = _scan_datetime.now(_scan_timezone.utc).strftime(\"%Y%m%dT%H%M%SZ\")\nSCAN_RUN_STATUS = \"RUNNING\"\nSCAN_RUN_ERROR_TYPE = \"\"\nSCAN_RUN_ERROR_MESSAGE = \"\"\nSCAN_RUN_TRACEBACK = \"\"\n# Clear previous outputs so a failed run can never publish stale results as current.\nfor _stale_name in (\"results\", \"signals\"):\n    globals().pop(_stale_name, None)\ntry:\n    exec(compile(\"# Current market-data scan — no backtest or order execution.\\n",
    "\\n",
    "UNIVERSE_MARKETS = {\\\"SET\\\", \\\"MAI\\\"}\\n",
    "EXCLUDED_SECTORS = {\\\"BANK\\\", \\\"FIN\\\", \\\"INSUR\\\", \\\"PF&REIT\\\", \\\"PROP\\\", \\\"TOURISM\\\"}\\n",
    "MIN_MARKET_CAP_MBAHT = 5000.0\\n",
    "MIN_TOTAL20_VALUE_MBAHT = 20.0\\n",
    "MIN_PRICE_BAHT = 1.0\\n",
    "MAX_PRICE_BAHT = 80.0\\n",
    "CLASSIFICATION_SOURCE_USED = None\\n",
    "HEADERS = {\\\"User-Agent\\\": \\\"Mozilla/5.0 (compatible; Fast-Hybrid-Pro-Scanner/1.0)\\\", \\\"Accept\\\": \\\"*/*\\\"}\\n",
    "\\n",
    "def _flatten_columns(frame):\\n",
    "    frame = frame.copy()\\n",
    "    if isinstance(frame.columns, pd.MultiIndex):\\n",
    "        frame.columns = [\\\" \\\".join(str(x).strip() for x in col if str(x).strip() and str(x) != \\\"nan\\\") for col in frame.columns]\\n",
    "    else:\\n",
    "        frame.columns = [str(c).strip() for c in frame.columns]\\n",
    "    return frame\\n",
    "\\n",
    "def _find_col(frame, names):\\n",
    "    lookup = {str(c).strip().lower(): c for c in frame.columns}\\n",
    "    for name in names:\\n",
    "        if name.lower() in lookup:\\n",
    "            return lookup[name.lower()]\\n",
    "    return None\\n",
    "\\n",
    "def _normalize_classification(raw):\\n",
    "    raw = _flatten_columns(raw)\\n",
    "    symbol_col = _find_col(raw, [\\\"symbol\\\", \\\"ticker\\\"])\\n",
    "    market_col = _find_col(raw, [\\\"market\\\", \\\"market segment\\\"])\\n",
    "    sector_col = _find_col(raw, [\\\"sector\\\", \\\"sector name\\\"])\\n",
    "    company_col = _find_col(raw, [\\\"company name\\\", \\\"company\\\", \\\"name\\\", \\\"security name\\\"])\\n",
    "    industry_col = _find_col(raw, [\\\"industry group\\\", \\\"industry\\\"])\\n",
    "    if not all([symbol_col, market_col, sector_col]):\\n",
    "        raise ValueError(f\\\"Classification missing required fields; columns={list(raw.columns)}\\\")\\n",
    "    out = pd.DataFrame({\\n",
    "        \\\"Symbol\\\": raw[symbol_col].astype(str).str.strip().str.upper(),\\n",
    "        \\\"Market\\\": raw[market_col].astype(str).str.strip().str.upper(),\\n",
    "        \\\"Sector\\\": raw[sector_col].astype(str).str.strip().str.upper(),\\n",
    "        \\\"Industry\\\": raw[industry_col].astype(str).str.strip().str.upper() if industry_col else \\\"\\\",\\n",
    "        \\\"Company\\\": raw[company_col].astype(str).str.strip() if company_col else \\\"\\\",\\n",
    "    })\\n",
    "    if not company_col:\\n",
    "        raise ValueError(\\\"Classification has no company-name field; cannot safely enforce ordinary-share-only gate\\\")\\n",
    "    ordinary = out[\\\"Company\\\"].str.contains(r\\\"PUBLIC COMPANY LIMITED|PUBLIC CO\\\\.?\\\\s*,?\\\\s*LTD\\\\.?|PCL\\\\.?$\\\", case=False, regex=True, na=False)\\n",
    "    out = out[ordinary].copy()\\n",
    "    sector_map = {\\n",
    "        \\\"BANKING\\\": \\\"BANK\\\", \\\"FINANCE & SECURITIES\\\": \\\"FIN\\\", \\\"INSURANCE\\\": \\\"INSUR\\\",\\n",
    "        \\\"PROPERTY DEVELOPMENT\\\": \\\"PROP\\\", \\\"PROPERTY FUND & REITS\\\": \\\"PF&REIT\\\",\\n",
    "        \\\"TOURISM & LEISURE\\\": \\\"TOURISM\\\",\\n",
    "    }\\n",
    "    out[\\\"Sector\\\"] = out[\\\"Sector\\\"].replace(sector_map)\\n",
    "    out = out[out[\\\"Market\\\"].isin(UNIVERSE_MARKETS)]\\n",
    "    out = out[out[\\\"Symbol\\\"].ne(\\\"\\\") & out[\\\"Symbol\\\"].ne(\\\"NAN\\\")].drop_duplicates(\\\"Symbol\\\")\\n",
    "    if out.empty:\\n",
    "        raise ValueError(\\\"No SET/mai listed companies remained after classification normalization\\\")\\n",
    "    return out.reset_index(drop=True)\\n",
    "\\n",
    "def load_set_classification():\\n",
    "    global CLASSIFICATION_SOURCE_USED\\n",
    "    official_url = \\\"https://www.set.or.th/dat/eod/listedcompany/static/listedCompanies_en_US.xls\\\"\\n",
    "    try:\\n",
    "        response = requests.get(official_url, headers=HEADERS, timeout=30)\\n",
    "        response.raise_for_status()\\n",
    "        raw = None\\n",
    "        try:\\n",
    "            raw = pd.read_excel(io.BytesIO(response.content))\\n",
    "        except Exception:\\n",
    "            tables = pd.read_html(io.BytesIO(response.content))\\n",
    "            if tables:\\n",
    "                raw = tables[0]\\n",
    "        if raw is not None:\\n",
    "            result = _normalize_classification(raw)\\n",
    "            CLASSIFICATION_SOURCE_USED = official_url\\n",
    "            return result\\n",
    "    except Exception as exc:\\n",
    "        print(\\\"Official SET listing unavailable; trying public mirror:\\\", type(exc).__name__)\\n",
    "    mirror_url = \\\"https://raw.githubusercontent.com/lumduan/thai-securities-data/main/thai_securities_all_en.json\\\"\\n",
    "    response = requests.get(mirror_url, headers=HEADERS, timeout=30)\\n",
    "    response.raise_for_status()\\n",
    "    payload = response.json()\\n",
    "    raw = pd.DataFrame(payload if isinstance(payload, list) else list(payload.values()))\\n",
    "    result = _normalize_classification(raw)\\n",
    "    CLASSIFICATION_SOURCE_USED = mirror_url\\n",
    "    return result\\n",
    "\\n",
    "def normalize_ohlcv(raw):\\n",
    "    if raw is None or raw.empty:\\n",
    "        return pd.DataFrame()\\n",
    "    frame = raw.copy()\\n",
    "    if isinstance(frame.columns, pd.MultiIndex):\\n",
    "        levels = [set(map(str, frame.columns.get_level_values(i))) for i in range(frame.columns.nlevels)]\\n",
    "        price_names = {\\\"Open\\\", \\\"High\\\", \\\"Low\\\", \\\"Close\\\", \\\"Volume\\\"}\\n",
    "        chosen = next((i for i, values in enumerate(levels) if price_names.issubset(values)), 0)\\n",
    "        frame.columns = frame.columns.get_level_values(chosen)\\n",
    "    frame = frame.loc[:, ~frame.columns.duplicated()].copy()\\n",
    "    rename = {str(c).strip().title(): str(c).strip().title() for c in frame.columns}\\n",
    "    frame.columns = [rename[str(c).strip().title()] for c in frame.columns]\\n",
    "    required = [\\\"Open\\\", \\\"High\\\", \\\"Low\\\", \\\"Close\\\", \\\"Volume\\\"]\\n",
    "    missing = [c for c in required if c not in frame.columns]\\n",
    "    if missing:\\n",
    "        raise ValueError(f\\\"Missing OHLCV columns {missing}; got {list(frame.columns)}\\\")\\n",
    "    frame = frame[required].copy()\\n",
    "    frame.index = pd.to_datetime(frame.index)\\n",
    "    if getattr(frame.index, \\\"tz\\\", None) is not None:\\n",
    "        frame.index = frame.index.tz_localize(None)\\n",
    "    for col in required:\\n",
    "        frame[col] = pd.to_numeric(frame[col], errors=\\\"coerce\\\")\\n",
    "    frame = frame.dropna(subset=[\\\"Open\\\", \\\"High\\\", \\\"Low\\\", \\\"Close\\\", \\\"Volume\\\"])\\n",
    "    frame = frame[~frame.index.duplicated(keep=\\\"last\\\")].sort_index()\\n",
    "    # Exclude today's possibly incomplete daily candle (Thailand local date).\\n",
    "    today_bkk = pd.Timestamp.now(tz=\\\"Asia/Bangkok\\\").date()\\n",
    "    frame = frame[frame.index.date < today_bkk]\\n",
    "    return frame\\n",
    "\\n",
    "def get_market_cap_baht(ticker):\\n",
    "    try:\\n",
    "        value = yf.Ticker(ticker).fast_info.get(\\\"market_cap\\\")\\n",
    "        if value is not None and np.isfinite(float(value)):\\n",
    "            return float(value)\\n",
    "    except Exception:\\n",
    "        pass\\n",
    "    try:\\n",
    "        value = yf.Ticker(ticker).info.get(\\\"marketCap\\\")\\n",
    "        if value is not None and np.isfinite(float(value)):\\n",
    "            return float(value)\\n",
    "    except Exception:\\n",
    "        pass\\n",
    "    return np.nan\\n",
    "\\n",
    "def extract_ticker_frame(batch_frame, ticker, batch_size):\\n",
    "    if batch_frame is None or batch_frame.empty:\\n",
    "        return pd.DataFrame()\\n",
    "    if isinstance(batch_frame.columns, pd.MultiIndex):\\n",
    "        for level in range(batch_frame.columns.nlevels):\\n",
    "            if ticker in set(map(str, batch_frame.columns.get_level_values(level))):\\n",
    "                try:\\n",
    "                    item = batch_frame.xs(ticker, axis=1, level=level, drop_level=True)\\n",
    "                    return normalize_ohlcv(item)\\n",
    "                except Exception:\\n",
    "                    continue\\n",
    "        if batch_size == 1:\\n",
    "            return normalize_ohlcv(batch_frame)\\n",
    "        return pd.DataFrame()\\n",
    "    return normalize_ohlcv(batch_frame) if batch_size == 1 else pd.DataFrame()\\n",
    "\\n",
    "def download_yahoo_history(ticker, period, attempts=2):\\n",
    "    \\\"\\\"\\\"Download one ticker with bounded retries; empty symbol results fail quickly.\\\"\\\"\\\"\\n",
    "    last_error = None\\n",
    "    for attempt in range(1, attempts + 1):\\n",
    "        try:\\n",
    "            raw = yf.download(\\n",
    "                ticker, period=period, interval=\\\"1d\\\", auto_adjust=False,\\n",
    "                progress=False, threads=False, timeout=20,\\n",
    "            )\\n",
    "            frame = normalize_ohlcv(raw)\\n",
    "            if not frame.empty:\\n",
    "                return frame\\n",
    "            last_error = \\\"Yahoo returned no OHLCV rows\\\"\\n",
    "        except Exception as exc:\\n",
    "            last_error = f\\\"{type(exc).__name__}: {exc}\\\"\\n",
    "        if attempt < attempts:\\n",
    "            time.sleep(1.5 * attempt)\\n",
    "    print(f\\\"YAHOO_TICKER_UNAVAILABLE {ticker} | {last_error}\\\")\\n",
    "    return pd.DataFrame()\\n",
    "\\n",
    "def get_official_set_latest_trading_date():\\n",
    "    \\\"\\\"\\\"\\n",
    "    Resolve the latest completed SET trading date from official SET market pages.\\n",
    "    Supports English and Thai date formats, and excludes dates on the official\\n",
    "    SET holiday calendar. Fail closed if the source does not provide a verifiable\\n",
    "    recent non-holiday date.\\n",
    "    \\\"\\\"\\\"\\n",
    "    from html import unescape\\n",
    "    from datetime import timedelta, date\\n",
    "\\n",
    "    reference_urls = [\\n",
    "        \\\"https://www.set.or.th/en/market/statistics/five-days\\\",\\n",
    "        \\\"https://www.set.or.th/th/market/statistics/five-days\\\",\\n",
    "        \\\"https://www.set.or.th/en/market/product/stock/overview?market=SET\\\",\\n",
    "        \\\"https://www.set.or.th/th/market/product/stock/overview?market=SET\\\",\\n",
    "    ]\\n",
    "    date_patterns = [\\n",
    "        re.compile(r\\\"\\\\\\\\b\\\\\\\\d{1,2}\\\\\\\\s+[A-Za-z]{3}\\\\\\\\s+\\\\\\\\d{4}\\\\\\\\b\\\"),\\n",
    "        re.compile(r\\\"\\\\\\\\b\\\\\\\\d{4}-\\\\\\\\d{2}-\\\\\\\\d{2}\\\\\\\\b\\\"),\\n",
    "        re.compile(r\\\"\\\\\\\\b\\\\\\\\d{1,2}\\\\\\\\s+[A-Za-z]+\\\\\\\\s+\\\\\\\\d{4}\\\\\\\\b\\\"),\\n",
    "    ]\\n",
    "    thai_months = {\\n",
    "        \\\"ม.ค.\\\": 1, \\\"มกราคม\\\": 1, \\\"ก.พ.\\\": 2, \\\"กุมภาพันธ์\\\": 2,\\n",
    "        \\\"มี.ค.\\\": 3, \\\"มีนาคม\\\": 3, \\\"เม.ย.\\\": 4, \\\"เมษายน\\\": 4,\\n",
    "        \\\"พ.ค.\\\": 5, \\\"พฤษภาคม\\\": 5, \\\"มิ.ย.\\\": 6, \\\"มิถุนายน\\\": 6,\\n",
    "        \\\"ก.ค.\\\": 7, \\\"กรกฎาคม\\\": 7, \\\"ส.ค.\\\": 8, \\\"สิงหาคม\\\": 8,\\n",
    "        \\\"ก.ย.\\\": 9, \\\"กันยายน\\\": 9, \\\"ต.ค.\\\": 10, \\\"ตุลาคม\\\": 10,\\n",
    "        \\\"พ.ย.\\\": 11, \\\"พฤศจิกายน\\\": 11, \\\"ธ.ค.\\\": 12, \\\"ธันวาคม\\\": 12,\\n",
    "    }\\n",
    "    english_months = {name.lower(): number for number, name in enumerate(\\n",
    "        [\\\"\\\", \\\"January\\\", \\\"February\\\", \\\"March\\\", \\\"April\\\", \\\"May\\\", \\\"June\\\",\\n",
    "         \\\"July\\\", \\\"August\\\", \\\"September\\\", \\\"October\\\", \\\"November\\\", \\\"December\\\"], 0\\n",
    "    ) if name}\\n",
    "    today = pd.Timestamp.now(tz=\\\"Asia/Bangkok\\\").date()\\n",
    "    earliest_acceptable = today - timedelta(days=14)\\n",
    "\\n",
    "    def visible_text(html):\\n",
    "        return unescape(re.sub(r\\\"<[^>]+>\\\", \\\" \\\", str(html))).replace(\\\"&nbsp;\\\", \\\" \\\")\\n",
    "\\n",
    "    # Build a set of official SET holidays for this calendar year so a stale\\n",
    "    # market-summary column labelled with a holiday is never mistaken for a\\n",
    "    # completed trading session.\\n",
    "    official_holidays = set()\\n",
    "    holiday_url = f\\\"https://www.set.or.th/en/about/event-calendar/holiday?year={today.year}\\\"\\n",
    "    try:\\n",
    "        holiday_response = requests.get(holiday_url, headers=HEADERS, timeout=30)\\n",
    "        holiday_response.raise_for_status()\\n",
    "        holiday_text = re.sub(r\\\"\\\\\\\\s+\\\", \\\" \\\", visible_text(holiday_response.text))\\n",
    "        for month_name, month_num in english_months.items():\\n",
    "            for day_match in re.finditer(\\n",
    "                rf\\\"\\\\\\\\b{re.escape(month_name)}\\\\\\\\s+(\\\\\\\\d{{1,2}})(?:st|nd|rd|th)?\\\\\\\\b\\\",\\n",
    "                holiday_text, flags=re.IGNORECASE\\n",
    "            ):\\n",
    "                try:\\n",
    "                    official_holidays.add(date(today.year, month_num, int(day_match.group(1))))\\n",
    "                except ValueError:\\n",
    "                    pass\\n",
    "        for month_name, month_num in thai_months.items():\\n",
    "            for day_match in re.finditer(\\n",
    "                rf\\\"\\\\\\\\b(\\\\\\\\d{{1,2}})\\\\\\\\s*{re.escape(month_name)}\\\\\\\\s*(\\\\\\\\d{{4}})?\\\",\\n",
    "                holiday_text\\n",
    "            ):\\n",
    "                try:\\n",
    "                    year_text = day_match.group(2)\\n",
    "                    year_num = int(year_text) - 543 if year_text and int(year_text) > 2400 else int(year_text) if year_text else today.year\\n",
    "                    official_holidays.add(date(year_num, month_num, int(day_match.group(1))))\\n",
    "                except ValueError:\\n",
    "                    pass\\n",
    "        print(\\\"Official SET holiday dates parsed:\\\", len(official_holidays))\\n",
    "    except Exception as exc:\\n",
    "        print(\\\"Official SET holiday calendar unavailable:\\\", type(exc).__name__)\\n",
    "\\n",
    "    date_candidates = []\\n",
    "    pages_read = []\\n",
    "    for reference_url in reference_urls:\\n",
    "        try:\\n",
    "            response = requests.get(reference_url, headers=HEADERS, timeout=30)\\n",
    "            response.raise_for_status()\\n",
    "        except Exception as exc:\\n",
    "            print(f\\\"SET date source unavailable: {reference_url} ({type(exc).__name__})\\\")\\n",
    "            continue\\n",
    "        pages_read.append(reference_url)\\n",
    "        text_value = re.sub(r\\\"\\\\\\\\s+\\\", \\\" \\\", visible_text(response.text))\\n",
    "        matches = []\\n",
    "        for pattern in date_patterns:\\n",
    "            matches.extend(pattern.findall(text_value))\\n",
    "        for match in matches:\\n",
    "            parsed = pd.to_datetime(match, errors=\\\"coerce\\\", dayfirst=True)\\n",
    "            if pd.isna(parsed):\\n",
    "                continue\\n",
    "            day = parsed.date()\\n",
    "            if earliest_acceptable <= day < today and day not in official_holidays:\\n",
    "                date_candidates.append((day, reference_url))\\n",
    "\\n",
    "        # Thai Buddhist-calendar dates (e.g. 12 ต.ค. 2569) need explicit\\n",
    "        # conversion. Only accept these if the official holiday calendar loaded.\\n",
    "        if official_holidays:\\n",
    "            for day_text, month_text, year_text in re.findall(\\n",
    "                r\\\"\\\\\\\\b(\\\\\\\\d{1,2})\\\\\\\\s*(ม\\\\\\\\.ค\\\\\\\\.|มกราคม|ก\\\\\\\\.พ\\\\\\\\.|กุมภาพันธ์|มี\\\\\\\\.ค\\\\\\\\.|มีนาคม|เม\\\\\\\\.ย\\\\\\\\.|เมษายน|พ\\\\\\\\.ค\\\\\\\\.|พฤษภาคม|มิ\\\\\\\\.ย\\\\\\\\.|มิถุนายน|ก\\\\\\\\.ค\\\\\\\\.|กรกฎาคม|ส\\\\\\\\.ค\\\\\\\\.|สิงหาคม|ก\\\\\\\\.ย\\\\\\\\.|กันยายน|ต\\\\\\\\.ค\\\\\\\\.|ตุลาคม|พ\\\\\\\\.ย\\\\\\\\.|พฤศจิกายน|ธ\\\\\\\\.ค\\\\\\\\.|ธันวาคม)\\\\\\\\s*(\\\\\\\\d{4})\\\",\\n",
    "                text_value\\n",
    "            ):\\n",
    "                try:\\n",
    "                    year_num = int(year_text)\\n",
    "                    if year_num > 2400:\\n",
    "                        year_num -= 543\\n",
    "                    day = date(year_num, thai_months[month_text], int(day_text))\\n",
    "                    if earliest_acceptable <= day < today and day not in official_holidays:\\n",
    "                        date_candidates.append((day, reference_url))\\n",
    "                except ValueError:\\n",
    "                    pass\\n",
    "\\n",
    "    if not date_candidates:\\n",
    "        raise RuntimeError(\\n",
    "            \\\"OFFICIAL_MARKET_DATE_UNAVAILABLE: no recent completed non-holiday date \\\"\\n",
    "            \\\"could be verified from official SET market pages and holiday calendar. \\\"\\n",
    "            \\\"No report will be published.\\\"\\n",
    "        )\\n",
    "    latest_date, source_url = max(date_candidates, key=lambda item: item[0])\\n",
    "    print(\\\"Official SET market-date reference:\\\", source_url)\\n",
    "    print(\\\"Official SET pages checked:\\\", len(pages_read))\\n",
    "    print(\\\"Official SET latest completed trading date:\\\", latest_date)\\n",
    "    return latest_date\\n",
    "\\n",
    "print(\\\"Loading SET/mai listing and sector classification...\\\")\\n",
    "listed = load_set_classification()\\n",
    "listed = listed[~listed[\\\"Sector\\\"].isin(EXCLUDED_SECTORS)].copy()\\n",
    "print(\\\"Classification source:\\\", CLASSIFICATION_SOURCE_USED)\\n",
    "print(\\\"Candidates after sector exclusion:\\\", len(listed))\\n",
    "\\n",
    "# Stage 1: download short OHLCV only to apply price and 20-session liquidity gates.\\n",
    "symbols = listed[\\\"Symbol\\\"].tolist()\\n",
    "tickers = [f\\\"{symbol}.BK\\\" for symbol in symbols]\\n",
    "short_data = {}\\n",
    "missing_short = []\\n",
    "BATCH_SIZE = 20\\n",
    "for start in range(0, len(tickers), BATCH_SIZE):\\n",
    "    batch = tickers[start:start + BATCH_SIZE]\\n",
    "    print(f\\\"Downloading universe snapshot {start + 1}-{start + len(batch)} / {len(tickers)}\\\")\\n",
    "    try:\\n",
    "        raw_batch = yf.download(batch, period=\\\"3mo\\\", interval=\\\"1d\\\", auto_adjust=False, progress=False, threads=True, group_by=\\\"ticker\\\")\\n",
    "    except Exception as exc:\\n",
    "        print(\\\"Batch download failed:\\\", type(exc).__name__)\\n",
    "        raw_batch = pd.DataFrame()\\n",
    "    for ticker in batch:\\n",
    "        item = pd.DataFrame()\\n",
    "        try:\\n",
    "            item = extract_ticker_frame(raw_batch, ticker, len(batch))\\n",
    "        except Exception as exc:\\n",
    "            print(f\\\"YAHOO_BATCH_PARSE_WARNING {ticker} | {type(exc).__name__}\\\")\\n",
    "        # Yahoo batch responses can omit individual Thai tickers even when the\\n",
    "        # rest of the batch succeeds. Retry only the missing ticker separately.\\n",
    "        if len(item) < 20:\\n",
    "            item = download_yahoo_history(ticker, period=\\\"3mo\\\", attempts=2)\\n",
    "        if len(item) >= 20:\\n",
    "            short_data[ticker] = item\\n",
    "        else:\\n",
    "            missing_short.append(ticker)\\n",
    "\\n",
    "print(f\\\"Short OHLCV ready: {len(short_data)} / {len(tickers)}; unavailable/short: {len(missing_short)}\\\")\\n",
    "stage_rows = []\\n",
    "meta_by_ticker = {}\\n",
    "stale_short_data = {}\\n",
    "MAX_STALE_DAILY_BAR_DAYS = 7\\n",
    "today_bkk = pd.Timestamp.now(tz=\\\"Asia/Bangkok\\\").date()\\n",
    "for _, item in listed.iterrows():\\n",
    "    ticker = f\\\"{item['Symbol']}.BK\\\"\\n",
    "    frame = short_data.get(ticker)\\n",
    "    if frame is None or frame.empty:\\n",
    "        continue\\n",
    "    latest_bar_date = frame.index[-1].date()\\n",
    "    age_days = (today_bkk - latest_bar_date).days\\n",
    "    if age_days > MAX_STALE_DAILY_BAR_DAYS:\\n",
    "        stale_short_data[ticker] = f\\\"Stale daily data: latest bar {latest_bar_date}; {age_days} calendar days old\\\"\\n",
    "        continue\\n",
    "    recent = frame.tail(20)\\n",
    "    total20_mbaht = float((recent[\\\"Close\\\"] * recent[\\\"Volume\\\"]).sum() / 1_000_000.0)\\n",
    "    close = float(recent[\\\"Close\\\"].iloc[-1])\\n",
    "    if not (MIN_PRICE_BAHT <= close <= MAX_PRICE_BAHT and total20_mbaht > MIN_TOTAL20_VALUE_MBAHT):\\n",
    "        continue\\n",
    "    stage_rows.append({\\\"Ticker\\\": ticker, \\\"Symbol\\\": item[\\\"Symbol\\\"], \\\"Market\\\": item[\\\"Market\\\"], \\\"Sector\\\": item[\\\"Sector\\\"], \\\"LastPrice\\\": close, \\\"Total20TradingValueMBaht\\\": total20_mbaht})\\n",
    "    meta_by_ticker[ticker] = {\\\"Market\\\": item[\\\"Market\\\"], \\\"Sector\\\": item[\\\"Sector\\\"]}\\n",
    "\\n",
    "stage = pd.DataFrame(stage_rows)\\n",
    "if stage.empty:\\n",
    "    raise RuntimeError(\\\"No stocks passed the price and total-20-session traded-value gates; stopping safely.\\\")\\n",
    "print(f\\\"Price + total 20-session value + fresh-data pass: {len(stage)}\\\")\\n",
    "print(f\\\"Excluded for stale daily data (> {MAX_STALE_DAILY_BAR_DAYS} days): {len(stale_short_data)}\\\")\\n",
    "\\n",
    "# Stage 2: slower market-cap lookup only for stocks passing the price/liquidity gates.\\n",
    "cap_values = []\\n",
    "for i, ticker in enumerate(stage[\\\"Ticker\\\"], start=1):\\n",
    "    cap_baht = get_market_cap_baht(ticker)\\n",
    "    cap_mbaht = cap_baht / 1_000_000.0 if np.isfinite(cap_baht) else np.nan\\n",
    "    cap_values.append(cap_mbaht)\\n",
    "    if i == 1 or i % 10 == 0 or i == len(stage):\\n",
    "        print(f\\\"Market cap {i}/{len(stage)} | {ticker}\\\")\\n",
    "stage[\\\"MarketCapMBaht\\\"] = cap_values\\n",
    "stage = stage[np.isfinite(stage[\\\"MarketCapMBaht\\\"]) & (stage[\\\"MarketCapMBaht\\\"] > MIN_MARKET_CAP_MBAHT)].copy()\\n",
    "if stage.empty:\\n",
    "    raise RuntimeError(\\\"No stocks passed market cap > THB 5,000m; no signals produced.\\\")\\n",
    "print(f\\\"Full universe gate passed: {len(stage)} stocks\\\")\\n",
    "\\n",
    "# Stage 3: get ~1 year of daily data for indicator warm-up and scan latest completed bar.\\n",
    "stock_data = {}\\n",
    "metadata_by_symbol = {}\\n",
    "scan_errors = {}\\n",
    "stale_indicator_data = {}\\n",
    "for i, row in enumerate(stage.iterrows(), start=1):\\n",
    "    _, record = row\\n",
    "    ticker = record[\\\"Ticker\\\"]\\n",
    "    symbol = record[\\\"Symbol\\\"]\\n",
    "    try:\\n",
    "        frame = download_yahoo_history(ticker, period=\\\"1y\\\", attempts=2)\\n",
    "        if len(frame) < 80:\\n",
    "            scan_errors[ticker] = f\\\"Insufficient completed daily bars: {len(frame)}\\\"\\n",
    "            continue\\n",
    "        latest_bar_date = frame.index[-1].date()\\n",
    "        age_days = (pd.Timestamp.now(tz=\\\"Asia/Bangkok\\\").date() - latest_bar_date).days\\n",
    "        if age_days > MAX_STALE_DAILY_BAR_DAYS:\\n",
    "            stale_indicator_data[ticker] = f\\\"Stale indicator data: latest bar {latest_bar_date}; {age_days} calendar days old\\\"\\n",
    "            continue\\n",
    "        stock_data[ticker] = frame\\n",
    "        metadata_by_symbol[ticker] = {\\n",
    "            \\\"Market\\\": record[\\\"Market\\\"],\\n",
    "            \\\"Sector\\\": record[\\\"Sector\\\"],\\n",
    "            \\\"MarketCapMBaht\\\": float(record[\\\"MarketCapMBaht\\\"]),\\n",
    "            \\\"Total20TradingValueMBaht\\\": float(record[\\\"Total20TradingValueMBaht\\\"]),\\n",
    "        }\\n",
    "    except Exception as exc:\\n",
    "        scan_errors[ticker] = f\\\"{type(exc).__name__}: {exc}\\\"\\n",
    "    if i == 1 or i % 10 == 0 or i == len(stage):\\n",
    "        print(f\\\"Indicator history {i}/{len(stage)} | loaded={len(stock_data)} errors={len(scan_errors)}\\\")\\n",
    "\\n",
    "if not stock_data:\\n",
    "    raise RuntimeError(\\\"No qualifying stocks have fresh, sufficient OHLCV history. Stopping without output signals.\\\")\\n",
    "\\n",
    "# Enforce one common latest completed trading date across every published row.\\n",
    "expected_scan_date = max(frame.index[-1].date() for frame in stock_data.values())\\n",
    "for ticker in list(stock_data):\\n",
    "    ticker_date = stock_data[ticker].index[-1].date()\\n",
    "    if ticker_date != expected_scan_date:\\n",
    "        stale_indicator_data[ticker] = (\\n",
    "            f\\\"Latest bar {ticker_date} does not match common scan date {expected_scan_date}\\\"\\n",
    "        )\\n",
    "        stock_data.pop(ticker)\\n",
    "        metadata_by_symbol.pop(ticker, None)\\n",
    "if not stock_data:\\n",
    "    raise RuntimeError(\\\"No stocks share a common latest completed daily bar; stopping without publishing.\\\")\\n",
    "official_set_latest_date = get_official_set_latest_trading_date()\\n",
    "if expected_scan_date != official_set_latest_date:\\n",
    "    raise RuntimeError(\\n",
    "        \\\"MARKET_DATE_MISMATCH: latest completed Yahoo Finance bar \\\"\\n",
    "        f\\\"{expected_scan_date} does not match SET's official latest trading date \\\"\\n",
    "        f\\\"{official_set_latest_date}. Refusing to publish stale or incomplete scan data.\\\"\\n",
    "    )\\n",
    "print(\\\"Official market-date validation: PASS\\\")\\n",
    "print(f\\\"Common completed scan date: {expected_scan_date}\\\")\\n",
    "print(f\\\"Excluded for stale/mismatched indicator data: {len(stale_indicator_data)}\\\")\\n",
    "\\n",
    "\\n",
    "# Attach free intraday prices as reference fields only; daily signals remain unchanged.\\n",
    "from datetime import time as dt_time\\n",
    "\\n",
    "BANGKOK_TZ = \\\"Asia/Bangkok\\\"\\n",
    "now_bkk = pd.Timestamp.now(tz=BANGKOK_TZ)\\n",
    "clock = now_bkk.time()\\n",
    "weekday_session = now_bkk.weekday() < 5\\n",
    "inside_set_session = weekday_session and (\\n",
    "    dt_time(10, 0) <= clock <= dt_time(12, 30)\\n",
    "    or dt_time(14, 30) <= clock <= dt_time(16, 30)\\n",
    ")\\n",
    "# A Yahoo 15-minute bar timestamp marks the BAR START, not its close.\\n",
    "# Allow up to 30 minutes since bar close (15-minute bar + approximately 15-minute feed delay).\\n",
    "INTRADAY_BAR_MINUTES = 15\\n",
    "INTRADAY_MAX_AGE_MINUTES = 30\\n",
    "INTRADAY_RETRY_ATTEMPTS = 2\\n",
    "intraday_quote_by_ticker = {}\\n",
    "intraday_quote_errors = {}\\n",
    "\\n",
    "def _intraday_frame_for_ticker(raw, ticker, batch_size):\\n",
    "    if raw is None or raw.empty:\\n",
    "        return pd.DataFrame()\\n",
    "    item = pd.DataFrame()\\n",
    "    if isinstance(raw.columns, pd.MultiIndex):\\n",
    "        for level in range(raw.columns.nlevels):\\n",
    "            if ticker in set(map(str, raw.columns.get_level_values(level))):\\n",
    "                try:\\n",
    "                    item = raw.xs(ticker, axis=1, level=level, drop_level=True).copy()\\n",
    "                    break\\n",
    "                except Exception:\\n",
    "                    continue\\n",
    "        if item.empty and batch_size == 1:\\n",
    "            item = raw.copy()\\n",
    "    elif batch_size == 1:\\n",
    "        item = raw.copy()\\n",
    "    if item.empty:\\n",
    "        return pd.DataFrame()\\n",
    "    item.columns = [str(column).strip().title() for column in item.columns]\\n",
    "    if \\\"Close\\\" not in item.columns:\\n",
    "        return pd.DataFrame()\\n",
    "    item = item.loc[:, ~item.columns.duplicated()].copy()\\n",
    "    item[\\\"Close\\\"] = pd.to_numeric(item[\\\"Close\\\"], errors=\\\"coerce\\\")\\n",
    "    item = item.dropna(subset=[\\\"Close\\\"])\\n",
    "    item = item[item[\\\"Close\\\"] > 0].sort_index()\\n",
    "    if item.empty:\\n",
    "        return pd.DataFrame()\\n",
    "    item.index = pd.to_datetime(item.index)\\n",
    "    if getattr(item.index, \\\"tz\\\", None) is None:\\n",
    "        item.index = item.index.tz_localize(\\\"UTC\\\")\\n",
    "    item.index = item.index.tz_convert(BANGKOK_TZ)\\n",
    "    return item\\n",
    "\\n",
    "freshness_tickers = [str(ticker) for ticker in stock_data.keys()]\\n",
    "raw_intraday = pd.DataFrame()\\n",
    "if freshness_tickers:\\n",
    "    try:\\n",
    "        raw_intraday = yf.download(\\n",
    "            freshness_tickers, period=\\\"5d\\\", interval=\\\"15m\\\",\\n",
    "            auto_adjust=False, progress=False, threads=True, group_by=\\\"ticker\\\",\\n",
    "        )\\n",
    "    except Exception as exc:\\n",
    "        intraday_quote_errors[\\\"__BATCH__\\\"] = f\\\"{type(exc).__name__}: {exc}\\\"\\n",
    "\\n",
    "for ticker in freshness_tickers:\\n",
    "    try:\\n",
    "        intraday = _intraday_frame_for_ticker(raw_intraday, ticker, len(freshness_tickers))\\n",
    "        # Ignore an in-progress 15-minute candle: it is not a completed price observation.\\n",
    "        if not intraday.empty:\\n",
    "            intraday = intraday[\\n",
    "                intraday.index + pd.Timedelta(minutes=INTRADAY_BAR_MINUTES) <= now_bkk\\n",
    "            ]\\n",
    "        # Retry stale/missing batch results as single-symbol requests. This can recover\\n",
    "        # per-symbol bars omitted or delayed by Yahoo's multi-ticker endpoint.\\n",
    "        for attempt in range(1, INTRADAY_RETRY_ATTEMPTS + 1):\\n",
    "            needs_retry = intraday.empty\\n",
    "            if not intraday.empty:\\n",
    "                candidate_start = intraday.index[-1]\\n",
    "                candidate_end = candidate_start + pd.Timedelta(minutes=INTRADAY_BAR_MINUTES)\\n",
    "                candidate_age = (now_bkk - candidate_end).total_seconds() / 60.0\\n",
    "                needs_retry = not (0 <= candidate_age <= INTRADAY_MAX_AGE_MINUTES)\\n",
    "            if not needs_retry:\\n",
    "                break\\n",
    "            try:\\n",
    "                raw_one = yf.download(\\n",
    "                    ticker, period=\\\"1d\\\", interval=\\\"15m\\\", auto_adjust=False,\\n",
    "                    progress=False, threads=False, timeout=20,\\n",
    "                )\\n",
    "                refreshed = _intraday_frame_for_ticker(raw_one, ticker, 1)\\n",
    "                if not refreshed.empty:\\n",
    "                    refreshed = refreshed[\\n",
    "                        refreshed.index + pd.Timedelta(minutes=INTRADAY_BAR_MINUTES) <= now_bkk\\n",
    "                    ]\\n",
    "                if not refreshed.empty and (intraday.empty or refreshed.index[-1] > intraday.index[-1]):\\n",
    "                    intraday = refreshed\\n",
    "            except Exception as retry_exc:\\n",
    "                print(f\\\"INTRADAY_RETRY_FAILED {ticker} attempt={attempt}: {type(retry_exc).__name__}\\\")\\n",
    "            if attempt < INTRADAY_RETRY_ATTEMPTS and intraday.empty:\\n",
    "                time.sleep(1.0 * attempt)\\n",
    "\\n",
    "        if intraday.empty:\\n",
    "            intraday_quote_errors[ticker] = \\\"Yahoo Finance returned no intraday Close bars after retry\\\"\\n",
    "            continue\\n",
    "        quote_time = intraday.index[-1]  # provider timestamp = start of the 15-minute bar\\n",
    "        quote_price = float(intraday[\\\"Close\\\"].iloc[-1])\\n",
    "        bar_close_time = quote_time + pd.Timedelta(minutes=INTRADAY_BAR_MINUTES)\\n",
    "        age_minutes = (now_bkk - bar_close_time).total_seconds() / 60.0\\n",
    "        quote_fresh = 0 <= age_minutes <= INTRADAY_MAX_AGE_MINUTES\\n",
    "        intraday_quote_by_ticker[ticker] = {\\n",
    "            \\\"LatestIntradayPrice\\\": quote_price,\\n",
    "            \\\"IntradayBarTimeBangkok\\\": quote_time.isoformat(),\\n",
    "            \\\"IntradayBarCloseTimeBangkok\\\": bar_close_time.isoformat(),\\n",
    "            \\\"IntradayAgeMinutes\\\": round(age_minutes, 2),\\n",
    "            \\\"IntradayPriceFreshnessStatus\\\": \\\"FRESH\\\" if quote_fresh else \\\"STALE\\\",\\n",
    "        }\\n",
    "        if inside_set_session and not quote_fresh:\\n",
    "            intraday_quote_errors[ticker] = (\\n",
    "                f\\\"Intraday bar stale/future after retries: bar_start={quote_time.isoformat()}, \\\"\\n",
    "                f\\\"bar_close={bar_close_time.isoformat()}, age_since_close={age_minutes:.1f} min\\\"\\n",
    "            )\\n",
    "    except Exception as exc:\\n",
    "        intraday_quote_errors[ticker] = f\\\"{type(exc).__name__}: {exc}\\\"\\n",
    "\\n",
    "print(\\\"Intraday source: Yahoo Finance free 15m bars; actual exchange delay is not guaranteed\\\")\\n",
    "print(\\\"Bangkok check time:\\\", now_bkk.isoformat())\\n",
    "print(\\\"Inside expected SET weekday session:\\\", inside_set_session)\\n",
    "print(\\\"Intraday bars retrieved:\\\", len(intraday_quote_by_ticker), \\\"/\\\", len(freshness_tickers))\\n",
    "print(\\\"Intraday freshness errors:\\\", len(intraday_quote_errors))\\n",
    "# During market hours, fail closed PER TICKER rather than discarding every valid\\n",
    "# signal because one Yahoo symbol is delayed. Only tickers with verified fresh\\n",
    "# intraday bars remain eligible for the published scan; exclusions force PARTIAL.\\n",
    "INTRADAY_CANDIDATE_COUNT = len(freshness_tickers)\\n",
    "intraday_exclusions = {}\\n",
    "if inside_set_session:\\n",
    "    for _ticker in list(stock_data):\\n",
    "        _quote = intraday_quote_by_ticker.get(_ticker, {})\\n",
    "        _issue = intraday_quote_errors.get(_ticker)\\n",
    "        if _issue or _quote.get(\\\"IntradayPriceFreshnessStatus\\\") != \\\"FRESH\\\":\\n",
    "            _reason = _issue or \\\"No verified fresh intraday bar available\\\"\\n",
    "            intraday_exclusions[_ticker] = _reason\\n",
    "            stock_data.pop(_ticker, None)\\n",
    "            metadata_by_symbol.pop(_ticker, None)\\n",
    "    print(\\\"Qualifying tickers before intraday freshness gate:\\\", INTRADAY_CANDIDATE_COUNT)\\n",
    "    print(\\\"Excluded due to stale/missing intraday data:\\\", len(intraday_exclusions))\\n",
    "    print(\\\"Tickers eligible for current-session scan:\\\", len(stock_data))\\n",
    "    if not stock_data:\\n",
    "        raise RuntimeError(\\n",
    "            \\\"STALE_DATA: no qualifying ticker had a verified fresh intraday bar during \\\"\\n",
    "            \\\"market hours. No current scan report should be published.\\\"\\n",
    "        )\\n",
    "\\n",
    "results = scan_universe(stock_data, metadata_by_symbol, CONFIG)\\n",
    "# Keep the daily signal formula unchanged; attach intraday values as separate reference fields.\\n",
    "_intraday_quote_for_symbol = lambda symbol: intraday_quote_by_ticker.get(\\n",
    "    (str(symbol).strip().upper() if str(symbol).strip().upper().endswith(\\\".BK\\\") else str(symbol).strip().upper() + \\\".BK\\\"), {}\\n",
    ")\\n",
    "if not results.empty:\\n",
    "    results[\\\"LatestIntradayPrice\\\"] = results[\\\"Symbol\\\"].map(\\n",
    "        lambda symbol: _intraday_quote_for_symbol(symbol).get(\\\"LatestIntradayPrice\\\", np.nan)\\n",
    "    )\\n",
    "    results[\\\"IntradayBarTimeBangkok\\\"] = results[\\\"Symbol\\\"].map(\\n",
    "        lambda symbol: _intraday_quote_for_symbol(symbol).get(\\\"IntradayBarTimeBangkok\\\", \\\"\\\")\\n",
    "    )\\n",
    "    results[\\\"IntradayAgeMinutes\\\"] = results[\\\"Symbol\\\"].map(\\n",
    "        lambda symbol: _intraday_quote_for_symbol(symbol).get(\\\"IntradayAgeMinutes\\\", np.nan)\\n",
    "    )\\n",
    "    results[\\\"IntradayPriceFreshnessStatus\\\"] = results[\\\"Symbol\\\"].map(\\n",
    "        lambda symbol: _intraday_quote_for_symbol(symbol).get(\\\"IntradayPriceFreshnessStatus\\\", \\\"UNAVAILABLE\\\")\\n",
    "    )\\n",
    "    if inside_set_session:\\n",
    "        intraday_ok = (\\n",
    "            pd.to_numeric(results[\\\"LatestIntradayPrice\\\"], errors=\\\"coerce\\\").gt(0)\\n",
    "            & pd.to_datetime(results[\\\"IntradayBarTimeBangkok\\\"], errors=\\\"coerce\\\").notna()\\n",
    "            & pd.to_numeric(results[\\\"IntradayAgeMinutes\\\"], errors=\\\"coerce\\\").between(0, INTRADAY_MAX_AGE_MINUTES)\\n",
    "            & results[\\\"IntradayPriceFreshnessStatus\\\"].eq(\\\"FRESH\\\")\\n",
    "        )\\n",
    "        if not intraday_ok.all():\\n",
    "            bad_symbols = results.loc[~intraday_ok, \\\"Symbol\\\"].astype(str).head(10).tolist()\\n",
    "            raise RuntimeError(\\n",
    "                \\\"STALE_DATA: intraday prices could not be mapped and validated for every result row. \\\"\\n",
    "                f\\\"Bad symbols: {bad_symbols}. No current scan report should be published.\\\"\\n",
    "            )\\n",
    "\\n",
    "if results.empty:\\n",
    "    raise RuntimeError(\\\"Scanner returned no rows; stopping without publishing.\\\")\\n",
    "if results[\\\"Date\\\"].isna().any() or pd.to_datetime(results[\\\"Date\\\"], errors=\\\"coerce\\\").dt.date.nunique() != 1:\\n",
    "    raise RuntimeError(\\\"REPORT_DATA_QUALITY_FAILED: scan rows do not share one valid scan date; refusing to publish.\\\")\\n",
    "if (results[\\\"UniverseStatus\\\"] == \\\"SCAN_ERROR\\\").any():\\n",
    "    scan_errors[\\\"SCANNER_INTERNAL\\\"] = f\\\"{int((results['UniverseStatus'] == 'SCAN_ERROR').sum())} internal scan errors\\\"\\n",
    "results = results.sort_values([\\\"EARLY_ENTRY\\\", \\\"ENTRY_SCORE\\\"], ascending=[False, False], na_position=\\\"last\\\")\\n",
    "signals = results[(results[\\\"EARLY_ENTRY\\\"] == True) | (results[\\\"EARLY_WARNING\\\"].isin([\\\"WATCH\\\", \\\"WARNING\\\"]))].copy()\\n",
    "\\n",
    "print(\\\"\\\\n",
    "\\\" + \\\"=\\\" * 90)\\n",
    "print(\\\"DAILY SIGNALS + SEPARATE INTRADAY PRICE FRESHNESS CHECK\\\")\\n",
    "print(\\\"No backtest | no orders | daily indicator formula unchanged | free Yahoo source only\\\")\\n",
    "print(\\\"=\\\" * 90)\\n",
    "print(\\\"Classification source:\\\", CLASSIFICATION_SOURCE_USED)\\n",
    "print(\\\"Stocks passing all universe filters:\\\", len(stage))\\n",
    "print(\\\"Stocks with indicator data:\\\", len(stock_data))\\n",
    "print(\\\"Scan errors:\\\", len(scan_errors))\\n",
    "print(\\\"Stale/mismatched data exclusions:\\\", len(stale_short_data) + len(stale_indicator_data))\\n",
    "print(\\\"EARLY ENTRY:\\\", int((results[\\\"EARLY_ENTRY\\\"] == True).sum()))\\n",
    "print(\\\"WATCH/WARNING:\\\", int(results[\\\"EARLY_WARNING\\\"].isin([\\\"WATCH\\\", \\\"WARNING\\\"]).sum()))\\n",
    "display(signals if not signals.empty else results.head(20))\\n",
    "\\n",
    "# Export the scan report from this Colab session (not to GitHub/main).\\n",
    "output_path = \\\"/content/fast_hybrid_pro_live_scan.csv\\\"\\n",
    "results.to_csv(output_path, index=False, encoding=\\\"utf-8-sig\\\")\\n",
    "print(\\\"CSV report saved:\\\", output_path)\\n",
    "try:\\n",
    "    from google.colab import files\\n",
    "    files.download(output_path)\\n",
    "except Exception:\\n",
    "    print(\\\"Not running in Google Colab; CSV remains at\\\", output_path)\\n",
    "\\n",
    "if scan_errors:\\n",
    "    print(\\\"\\\\n",
    "First 20 scan errors:\\\")\\n",
    "    for ticker, message in list(scan_errors.items())[:20]:\\n",
    "        print(f\\\"{ticker}: {message}\\\")\\n",
    "if intraday_exclusions:\\n",
    "    print(\\\"\\\\n",
    "First 20 symbols excluded for stale/missing intraday data:\\\")\\n",
    "    for ticker, message in list(intraday_exclusions.items())[:20]:\\n",
